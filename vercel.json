{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "env": {
    "DATABASE_URL": {
      "description": "MySQL database connection string"
    },
    "JWT_SECRET": {
      "description": "Secret key for JWT session signing"
    },
    "VITE_APP_ID": {
      "description": "Manus OAuth application ID"
    },
    "OAUTH_SERVER_URL": {
      "description": "Manus OAuth server URL"
    },
    "OWNER_OPEN_ID": {
      "description": "Owner's Manus Open ID"
    },
    "OWNER_NAME": {
      "description": "Owner's name"
    },
    "BUILT_IN_FORGE_API_URL": {
      "description": "Manus built-in API URL"
    },
    "BUILT_IN_FORGE_API_KEY": {
      "description": "Manus built-in API key"
    },
    "VITE_FRONTEND_FORGE_API_KEY": {
      "description": "Frontend Manus API key"
    },
    "VITE_FRONTEND_FORGE_API_URL": {
      "description": "Frontend Manus API URL"
    },
    "VITE_OAUTH_PORTAL_URL": {
      "description": "Manus OAuth portal URL"
    },
    "VITE_APP_TITLE": {
      "description": "Application title"
    },
    "VITE_APP_LOGO": {
      "description": "Application logo URL or path"
    }
  },
  "regions": ["sfo1"],
  "functions": {
    "server/_core/index.ts": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
